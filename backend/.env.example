PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/anon_db
SESSION_SECRET=dev_session_secret_replace_in_production_32bytes_min
JWT_SECRET=dev_jwt_secret_replace_in_production_32bytes_min
# Note: Moderator permissions are managed server-side via the isModerator flag (assigned by admin)
CLIENT_ORIGIN=http://localhost:5173

# AI Configuration (Optional - platform functions with informative banner if unconfigured)
# Supported AI_PROVIDER values: gemini, openai, none
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Admin Configuration
ADMIN_EMAIL=koketalemayehu.1@gmail.com
ADMIN_PASSWORD=your_admin_password_here
